.global start
.extern kernel_main

.section .multiboot_header
header_start:
.long 0xe85250d6 # Magiczna liczba multiboot2
.long 0 # Architektura (0 = protected mode / long mode)
.long header_end - header_start # Długość nagłówka
.long 0x100000000 - (0xe85250d6 + 0 + (header_end - header_start)) # Suma kontrolna (checksum)

# Tag końcowy wymagany przez specyfikację Multiboot2
.word 0
.word 0
.long 8
header_end:

.section .text
.bits 64
start:
# Ustawienie stosu dla kernela w architekturze 64-bitowej
lea stack_top(%rip), %rsp

# Przejście do głównej funkcji w Ruście (kernel_main)
call kernel_main

# Pętla awaryjna, gdyby kernel z jakiegoś powodu się zakończył
.Lhang:
cli
hlt
jmp .Lhang

.section .bss
.align 16
stack_bottom:
.skip 4096 * 4 # Rezerwujemy 16 KB pamięci na stos kernela
stack_top: